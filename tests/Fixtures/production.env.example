# Non-secret production deployment fixture (Lab 9 Part F3). Real values live in the deployment secret store.
APP_ENV=production
APP_DEBUG=false
# APP_KEY is injected by the deployment platform; it must never be committed.
APP_KEY=
APP_URL=https://app.example.test

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
